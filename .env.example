PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=sims_db
DB_ITEMS_TABLE=inventory_items

AUTO_CREATE_TABLES=true

# Optional when frontend and backend are hosted separately.
VITE_API_BASE_URL=

# Email (account activation, deactivation, password reset OTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SIMS <noreply@sims.lk>
APP_NAME=SIMS Inventory Management System
# When SMTP is not set: in non-production, OTP is shown in the UI for testing.
# Set to false to require SMTP even locally. Set to true to force dev OTP in production (not recommended).
EMAIL_DEV_MODE=